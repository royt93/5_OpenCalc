<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/foreground_color">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="?attr/background_color">

        <HorizontalScrollView
            android:id="@+id/inputHorizontalScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/foreground_color"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/guideline1"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/input"
                style="@style/RobotoFontCondensedMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:autofillHints="false"
                android:background="?attr/foreground_color"
                android:inputType="textNoSuggestions"
                android:maxLength="200"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:text=""
                android:textAlignment="textEnd"
                android:textColor="?attr/text_color"
                android:textSize="55sp"
                tools:ignore="LabelFor,RtlCompat" />

        </HorizontalScrollView>

        <EditText
            android:id="@+id/resultDisplay"
            style="@style/RobotoFontCondensedMedium"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/foreground_color"
            android:clickable="false"
            android:cursorVisible="false"
            android:focusable="false"
            android:inputType="textNoSuggestions"
            android:paddingHorizontal="10dp"
            android:paddingBottom="4dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text=""
            android:textAlignment="textEnd"
            android:textColor="?attr/text_second_color"
            android:textSize="35sp"
            app:layout_constraintBottom_toTopOf="@+id/guideline2"
            app:layout_constraintTop_toTopOf="@+id/guideline1"
            tools:ignore="Autofill,LabelFor" />

        <com.sothree.slidinguppanel.SlidingUpPanelLayout
            android:id="@+id/slidingLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="top"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/resultDisplay"
            app:umanoPanelHeight="41dp"
            app:umanoScrollableView="@id/rvHistory"
            app:umanoShadowHeight="0dp"
            tools:ignore="MissingConstraints">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:context=".MainActivity">

                <TableLayout
                    android:id="@+id/tableLayout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:layout_weight="0">

                        <Button
                            android:id="@+id/squareButton"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="squareButton"
                            android:text="@string/square"
                            android:textSize="26sp"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="piButton"
                            android:text="@string/pi"
                            android:textSize="26sp"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="divideBy100"
                            android:text="@string/divideBy100"
                            android:textSize="26sp"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="factorialButton"
                            android:text="@string/factorial"
                            android:textSize="26sp"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            android:id="@+id/scientistModeSwitchButton"
                            style="@style/Widget.AppCompat.Button.Borderless"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="0.6"
                            android:background="@drawable/ic_circle"
                            android:backgroundTint="?attr/foreground_color"
                            android:contentDescription="@string/cd_toggle_scientific_mode"
                            android:onClick="scientistModeSwitchButton"
                            android:textAllCaps="false"
                            android:textColor="?attr/text_color"
                            android:textSize="26sp"
                            app:srcCompat="@drawable/ic_baseline_keyboard_arrow_down_24"
                            tools:ignore="UsingOnClickInXml" />

                    </TableRow>

                    <TableRow
                        android:id="@+id/scientistModeRow2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <Button
                            android:id="@+id/degreeButton"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="degreeButton"
                            android:text="@string/degree_mode_deg"
                            android:textSize="22sp"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/sineButton"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="sineButton"
                            android:text="@string/sine"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/cosineButton"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="cosineButton"
                            android:text="@string/cosine"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/tangentButton"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="tangentButton"
                            android:text="@string/tangent"
                            tools:ignore="UsingOnClickInXml" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="0.6" />

                    </TableRow>

                    <TableRow
                        android:id="@+id/scientistModeRow3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <Button
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="invButton"
                            android:text="@string/inv"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="eButton"
                            android:text="@string/e"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/naturalLogarithmButton"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="naturalLogarithmButton"
                            android:text="@string/naturalLogarithm"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/logarithmButton"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="logarithmButton"
                            android:text="@string/logarithm"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/ansButton"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="0.6"
                            android:onClick="ansButton"
                            android:text="@string/ans"
                            android:textSize="14sp"
                            tools:ignore="UsingOnClickInXml,SmallSp" />

                    </TableRow>

                    <TableRow
                        android:id="@+id/scientistModeRow4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <Button
                            android:id="@+id/btnMemoryAdd"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="memoryAddButton"
                            android:text="@string/memory_add"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/btnMemorySubtract"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="memorySubtractButton"
                            android:text="@string/memory_subtract"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/btnMemoryRecall"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="memoryRecallButton"
                            android:text="@string/memory_recall"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            android:id="@+id/btnMemoryClear"
                            style="@style/CalculatorButton.Function"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:onClick="memoryClearButton"
                            android:text="@string/memory_clear"
                            tools:ignore="UsingOnClickInXml" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="0.6" />

                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3">

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/button_clear_color"
                            android:id="@+id/clearButton"
                            android:onClick="clearButton"
                            android:text="@string/clear"
                            android:textSize="24sp"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/button_symbol_color"
                            android:contentDescription="@string/cd_parentheses"
                            android:id="@+id/parenthesesButton"
                            android:onClick="parenthesesButton"
                            app:srcCompat="@drawable/ic_parentheses"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/button_symbol_color"
                            android:contentDescription="@string/cd_exponent"
                            android:id="@+id/exponentButton"
                            android:onClick="exponentButton"
                            app:srcCompat="@drawable/ic_exponent"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/button_symbol_color"
                            android:contentDescription="@string/cd_divide"
                            android:id="@+id/divideButton"
                            android:onClick="divideButton"
                            app:srcCompat="@drawable/ic_divide"
                            tools:ignore="UsingOnClickInXml" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3">

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/seven"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/eight"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/nine"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/button_symbol_color"
                            android:contentDescription="@string/cd_multiply"
                            android:id="@+id/multiplyButton"
                            android:onClick="multiplyButton"
                            app:srcCompat="@drawable/ic_multiply"
                            tools:ignore="UsingOnClickInXml" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="3">

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/four"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/five"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/six"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/button_symbol_color"
                            android:contentDescription="@string/cd_subtract"
                            android:id="@+id/subtractButton"
                            android:onClick="subtractButton"
                            app:srcCompat="@drawable/ic_subtract"
                            tools:ignore="UsingOnClickInXml" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="3">

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/one"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/two"
                            tools:ignore="UsingOnClickInXml" />

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/three"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/button_symbol_color"
                            android:contentDescription="@string/cd_add"
                            android:id="@+id/addButton"
                            android:onClick="addButton"
                            app:srcCompat="@drawable/ic_add"
                            tools:ignore="UsingOnClickInXml" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="3">

                        <Button
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:onClick="keyDigitPadMappingToDisplay"
                            android:text="@string/zero"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            android:id="@+id/pointButton"
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_decimal_point"
                            android:onClick="pointButton"
                            app:srcCompat="@drawable/ic_dot"
                            tools:ignore="UsingOnClickInXml" />

                        <ImageButton
                            android:id="@+id/backspaceButton"
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/backspace"
                            android:onClick="backspaceButton"
                            android:paddingEnd="5dp"
                            app:srcCompat="@drawable/ic_backspace"
                            tools:ignore="RtlSymmetry,UsingOnClickInXml" />

                        <ImageButton
                            style="@style/CalculatorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/button_equals_color"
                            android:contentDescription="@string/cd_equals"
                            android:id="@+id/equalsButton"
                            android:onClick="equalsButton"
                            app:srcCompat="@drawable/ic_equals"
                            tools:ignore="UsingOnClickInXml" />
                    </TableRow>
                </TableLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_display_background"
                tools:context=".MainActivity">

                <!-- N-DATA-3: lọc history theo biểu thức/kết quả -->
                <EditText
                    android:id="@+id/etHistorySearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:hint="@string/hint_search_history"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:textColor="?attr/text_color"
                    android:textColorHint="?attr/text_second_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="Autofill,LabelFor" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistory"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="32dp"
                    android:background="?attr/history_background_color"
                    app:layout_constraintBottom_toTopOf="@+id/slidingLayoutButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etHistorySearch" />

                <View
                    android:id="@+id/slidingLayoutButton"
                    android:layout_width="30dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="15dp"
                    android:background="?attr/text_color"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="MissingConstraints" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </com.sothree.slidinguppanel.SlidingUpPanelLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.18" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.26" />

        <!--<View
            android:id="@+id/separator"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:background="?attr/separator_color"
            app:layout_constraintTop_toTopOf="@+id/sliding_layout"
            tools:ignore="MissingConstraints" />-->

        <ImageButton
            android:id="@+id/btnAppMenu"
            style="@style/RobotoFontCondensedLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/ic_baseline_more_vert_24"
            android:contentDescription="@string/cd_more_options"
            android:onClick="openAppMenu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_baseline_more_vert_24"
            tools:ignore="UsingOnClickInXml" />

        <!-- Touch point VIP: LUÔN hiện ở action bar; màu sắc đổi theo trạng thái VIP
             (vàng đặc = đang VIP, viền = free) — set trong MainActivity.bindVipBadge(). -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipVipBadge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_margin="4dp"
            android:text="@string/vip_badge"
            android:textColor="@color/vip_on_gold"
            android:textSize="9sp"
            app:chipBackgroundColor="@color/vip_gold"
            app:chipCornerRadius="9dp"
            app:chipEndPadding="5dp"
            app:chipIcon="@drawable/ic_workspace_premium"
            app:chipIconTint="@color/vip_on_gold"
            app:chipMinHeight="18dp"
            app:chipStartPadding="4dp"
            app:ensureMinTouchTargetSize="false"
            app:iconEndPadding="1dp"
            app:iconStartPadding="0dp"
            app:textEndPadding="0dp"
            app:textStartPadding="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnAppMenu"
            app:layout_constraintEnd_toStartOf="@+id/btnAppMenu"
            app:layout_constraintTop_toTopOf="@+id/btnAppMenu"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/degreeTextView"
