<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background_color">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="28dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/ic_baseline_arrow_back_24"
                    android:backgroundTint="?attr/text_color"
                    android:contentDescription="@string/back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/vip_screen_title"
                    android:textColor="?attr/text_color"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- [1] Hero status card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:id="@+id/layoutStatusHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vip_status_header_free"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="32dp">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp">

                        <View
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:background="@drawable/bg_crown_circle" />

                        <ImageView
                            android:id="@+id/ivCrown"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/vip_screen_title"
                            android:src="@drawable/ic_workspace_premium"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/vip_free_user"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.92"
                        android:gravity="center"
                        android:text="@string/vip_subtitle_free"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- [4][5][2][3] Countdown + progress + dates -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.02"
                        android:textColor="?attr/text_color"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        tools:text="12d 03h 24m 15s" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressVip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:indicatorColor="@color/vip_gold"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="10dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="?attr/text_third_color"
                        android:alpha="0.18" />

                    <TextView
                        android:id="@+id/tvActivationDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="?attr/text_second_color"
                        android:textSize="13sp"
                        tools:text="Kích hoạt: 01/06/2026 10:00" />

                    <TextView
                        android:id="@+id/tvExpiryDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/text_second_color"
                        android:textSize="13sp"
                        tools:text="Hết hạn: 01/07/2026 10:00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- [12] Active VIP card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveVip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvActiveKeyLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="?attr/text_color"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_workspace_premium"
                        app:drawableTint="@color/vip_gold"
                        tools:text="🎁 Quà tặng cài đặt mới" />

                    <TextView
                        android:id="@+id/tvActiveRemaining"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/text_second_color"
                        android:textSize="13sp"
                        tools:text="Còn lại: 12d 3h" />

                    <TextView
                        android:id="@+id/tvActiveExpires"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/text_second_color"
                        android:textSize="13sp"
                        tools:text="Hết hạn: 01/07/2026 10:00" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRevoke"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="6dp"
                        android:text="@string/vip_revoke_all_button" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- [6] Redeem key -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilKey"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/vip_redeem_label"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_confirmation_number">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textVisiblePassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActivate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/vip_redeem_button"
                app:cornerRadius="14dp" />

            <!-- [7] Watch ad → 3 days VIP (CTA nổi bật, có chừa lề cho pulse) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatchAd"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="@string/vip_watch_ad_3d"
                android:textColor="@color/vip_on_gold"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/vip_gold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_play_circle"
                app:iconGravity="textStart"
                app:iconTint="@color/vip_on_gold" />

            <!-- [8-11][13] Upgrade group (disabled — sắp ra mắt) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/text_third_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy30d"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="@string/vip_buy_30d_locked"
                        app:icon="@drawable/ic_card_giftcard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy90d"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="@string/vip_buy_90d_locked"
                        app:icon="@drawable/ic_card_giftcard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy1y"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="@string/vip_buy_1y_locked"
                        app:icon="@drawable/ic_card_giftcard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuyLifetime"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="@string/vip_buy_lifetime_locked"
                        app:icon="@drawable/ic_card_giftcard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestore"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:enabled="false"
                        android:text="@string/vip_restore_locked"
                        app:icon="@drawable/ic_restore" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Revoke all -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRevokeAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vip_revoke_all_button" />

            <!-- Privacy footer -->
            <TextView
                android:id="@+id/tvPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:padding="8dp"
                android:text="@string/privacy_policy"
                android:textColor="?attr/text_third_color"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/viewKonfetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
